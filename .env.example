# =============================================================================
# Flight Matrix — Environment Variables
#
# Two-file layout (both gitignored):
#   .env.local  — local development: SQLite, auth bypass, SKIP_AUTH=true
#   .env.prod   — production: Aurora, Cognito, SES, real API keys
#
# Which one is loaded is controlled by $STAGE. YAMLConfig reads
# `.env.<stage>` and falls back to `.env` for legacy setups.
# DatabaseManager refuses to connect to an AWS RDS host when STAGE=local,
# so accidentally leaving a prod URL in .env.local is a loud error,
# not a silent data-leak.
#
# For local: `./scripts/quickstart.sh` creates .env.local for you.
# For prod:  `./scripts/deploy-aws.sh` writes .env.prod for you.
# Copy this file to either destination and fill in the real values.
# =============================================================================

# ---- Core ------------------------------------------------------------------
ENVIRONMENT=local           # local | dev | prod
AWS_REGION=us-east-1

# ---- Deployment target -----------------------------------------------------
# Selects which provider backs object storage, authentication and the LLM.
# Orthogonal to STAGE: STAGE says how strict to be (auth, secure cookies),
# DEPLOY_TARGET says which cloud's services to call. See
# src/core/deploy_target.py and config/deploy.yaml.
#   aws   — S3 + CloudFront, Cognito, Bedrock
#   gcp   — GCS, Google OAuth, Gemini
#   local — filesystem storage, mock auth, whichever LLM key is present
DEPLOY_TARGET=local

# ---- Local development (no auth, mock user) -------------------------------
STAGE=local
SKIP_AUTH=true
LOCAL_DEV_EMAIL=dev@example.com
LOCAL_DEV_GROUPS=admins,flight-schedules-viewers

# ---- Database --------------------------------------------------------------
# Either supply a full DATABASE_URL or the individual DB_* fields.
# For local dev, SQLite works out of the box:
#   DATABASE_URL=sqlite:///aircraft_data.db
# For Postgres:
#   DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///aircraft_data.db
DB_USERNAME=
DB_NAME=
DB_PASSWORD=
DB_HOST=
DB_ENDPOINT=

# ---- AWS infrastructure (import-mode CDK deploys) -------------------------
VPC_ID=
DB_SECURITY_GROUP_ID=
SERVICES_SECURITY_GROUP_ID=
S3_BUCKET_NAME=
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_DOMAIN=
PRIVATE_SUBNET_IDS=
ISOLATED_SUBNET_IDS=
PUBLIC_SUBNET_IDS=
AWS_ACCOUNT_ID=                       # auto-detected via STS if unset

# ---- Cognito authentication ------------------------------------------------
# Leave blank when SKIP_AUTH=true.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_CALLBACK_URL=
COGNITO_LOGOUT_URL=
COGNITO_JWKS=                         # JSON string; fetched once at startup if empty
FLASK_SECRET_KEY=                     # auto-generated per-process if unset

# ---- GCP infrastructure (DEPLOY_TARGET=gcp) -------------------------------
GOOGLE_CLOUD_PROJECT=
GCS_ASSETS_BUCKET=                    # public bucket; images are served from here
GCS_PRIVATE_BUCKET=                   # exports, backups, debug artefacts
# Base URL public object keys are served from. CloudFront on aws, the bucket
# URL on gcp, empty locally so the app serves /static itself.
STATIC_BASE_URL=
LOCAL_STORAGE_ROOT=                   # filesystem root for the local provider
GEMINI_API_KEY=                       # LLM on the gcp target

# ---- Google OAuth authentication (DEPLOY_TARGET=gcp) ----------------------
# Create a Web application OAuth client in the GCP Console under
# APIs & Services -> Credentials. Generic web clients cannot be created with
# the gcloud CLI, so this step is manual.
#
# The redirect URI must be https (except http://localhost), must not be a bare
# IP address, and must have a real TLD — a non-standard port is allowed. So
# https://<name>:8080/auth/callback is accepted and http://<ip>:8080/... is not.
# It has to match the registered value byte for byte, port included.
#
# Group membership does not come from here: Google ID tokens carry no group
# claim, so config/auth.yaml `auth.google.groups` is the source. An account that
# matches no group logs in successfully and is then denied by the group
# decorators.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=            # https://HOST[:PORT]/auth/callback
GOOGLE_OAUTH_LOGOUT_URL=              # where to land after logout
GOOGLE_JWKS=                          # JSON string; fetched from Google if empty

# ---- Third-party APIs ------------------------------------------------------
# Tavily (web search for AI analysis) — https://tavily.com
TAVILY_API_KEY=
# ADS-B Exchange via RapidAPI — https://rapidapi.com/adsbx/api/adsbexchange-com1
ADSB_API_KEY=

# ---- Email -----------------------------------------------------------------
SENDER_EMAIL=
AWS_SES_SENDER_EMAIL=
RECIPIENTS=                           # comma-separated
GMAIL_APP_PASSWORD=

# ---- Web app ---------------------------------------------------------------
APP_DOMAIN=                           # custom domain for URL generation
