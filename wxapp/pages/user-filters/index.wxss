.title {
  font-weight: 600;
  margin-bottom: 16rpx;
}
input, textarea {
  background: #f4f7fb;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  display: block;
  width: 100%;
  box-sizing: border-box;
}
textarea {
  min-height: 200rpx;
  font-family: "Menlo", "Monaco", monospace;
  font-size: 24rpx;
}
.mono {
  font-family: "Menlo", "Monaco", monospace;
  font-size: 22rpx;
  word-break: break-all;
}
