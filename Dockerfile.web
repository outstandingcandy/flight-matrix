# Dockerfile for the flight-matrix FastAPI web app.
#
# Serves the FastAPI application defined in ``app.py`` under gunicorn
# using the uvicorn worker class. Runtime state (``db_manager`` /
# ``config`` / ``api_cache``) lives in ``src/web/runtime.py`` and gets
# populated by the FastAPI lifespan handler at startup. Rollback to
# Flask requires the ``pre-fastapi-2026-08-24`` git tag.
#
# Multi-stage so the final image doesn't carry build-essential or the
# uv cache; structure follows Dockerfile.scraper's builder/runtime split.

FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /app

# pyproject.toml declares resilient-scraper as an editable path dependency
# (lib/resilient-scraper), so its source has to be present before `uv sync`
# runs, not copied in afterward.
COPY pyproject.toml uv.lock ./
COPY lib/resilient-scraper lib/resilient-scraper

# --frozen: install exactly what uv.lock says, fail rather than re-resolve.
# --no-dev: pytest/mypy/ruff have no place in a server image.
RUN uv sync --frozen --no-dev

FROM python:3.12-slim

RUN useradd -m -u 1000 webapp

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
# resilient-scraper is installed editable (pyproject.toml: `{ path =
# "lib/resilient-scraper", editable = true }`), so .venv holds a reference back
# to this source tree, not a copy of the package — without it here too, that
# reference dangles and anything importing resilient_scraper 404s at runtime.
# The web app itself never noticed: no request-serving code path imports it.
COPY --chown=webapp:webapp lib/resilient-scraper lib/resilient-scraper
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --chown=webapp:webapp app.py asgi.py ./
COPY --chown=webapp:webapp src/ ./src/
COPY --chown=webapp:webapp web_templates/ ./web_templates/
COPY --chown=webapp:webapp web_static/ ./web_static/
COPY --chown=webapp:webapp config/ ./config/
# One-off admin/migration scripts (e.g. migrate_backfill_image_airport_icao.py)
# run via `docker compose exec web python scripts/<name>.py` — the reason this
# container exists rather than a plain systemd process is being able to run
# these without a shell that has read access to /etc/flight-matrix/env.
COPY --chown=webapp:webapp scripts/ ./scripts/

USER webapp

EXPOSE 8000

# Same tuning as the previous Flask CMD, adapted to gunicorn's uvicorn worker
# class — uvicorn.workers.UvicornWorker speaks ASGI to app.py's FastAPI
# instance while keeping gunicorn as the process supervisor (graceful
# shutdown, worker restart, boot timeouts). --bind 0.0.0.0:8000 (not
# 127.0.0.1) because caddy reaches this container over the compose bridge
# network; 127.0.0.1 inside a container is the container itself, not the
# host.
#
#   - asgi:app — asgi.py exports the FastAPI ``app`` from app.py. The
#     FastAPI startup lives inside the app's ASGI lifespan handler
#     (populates db_manager / config via src.web.runtime.init_app()), so no
#     explicit init call is needed here.
#   - --timeout 300 — aircraft analysis calls an LLM inline and can run
#     for minutes; gunicorn's 30s default would kill the worker
#     mid-request.
#   - 2 workers instead of (2*CPU)+1 — the workload is IO-bound on the
#     database and the LLM, and each worker is a full copy of the app
#     (SQLAlchemy, plotly, the Google SDKs), so worker count dominates
#     resident memory more than it would for a CPU-bound service. The
#     uvicorn worker is single-threaded but async, so we don't set
#     --threads (that flag is a sync-worker concept and uvicorn workers
#     ignore it).
#
# Roll-back: check out the ``pre-fastapi-2026-08-24`` tag and rebuild.
# ``wsgi.py`` is gone from the tree, so an in-image CMD flip is no
# longer sufficient.
CMD ["gunicorn", \
     "asgi:app", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "2", \
     "--timeout", "300", \
     "--graceful-timeout", "30", \
     "--keep-alive", "5", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
