# Dockerfile for Flight Matrix Lambda Web API
# Uses AWS Lambda Python base image with custom dependencies

FROM public.ecr.aws/lambda/python:3.12

# Install system dependencies for PostgreSQL
RUN dnf install -y \
    gcc \
    python3-devel \
    postgresql-devel \
    && dnf clean all

# Set working directory to Lambda task root
WORKDIR ${LAMBDA_TASK_ROOT}

# Copy requirements first for better caching
COPY lambda_code/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY lambda_code/ ${LAMBDA_TASK_ROOT}/
COPY web_templates/ ${LAMBDA_TASK_ROOT}/web_templates/
COPY web_static/ ${LAMBDA_TASK_ROOT}/web_static/
COPY config/ ${LAMBDA_TASK_ROOT}/config/

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Set the CMD to Lambda handler
CMD ["lambda_handler.lambda_handler"]
