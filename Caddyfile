# Reverse proxy + TLS termination for flight-matrix-web. Uses a certificate
# already issued by the host's certbot (see scripts/gcp/provision-existing-host.sh
# / docs/deployment.md); Caddy does not manage the ACME lifecycle itself, since
# port 80 on this shared host belongs to a co-tenant Caddy (collecdex).
#
# `protocols h1 h2` disables HTTP/3 advertisement. Otherwise Caddy adds
# `alt-svc: h3=":8443"` on every response — but the host does not publish UDP
# :8443 to this container (host :8443 is held by xray). Chrome then caches the
# bogus h3 endpoint and stalls the next same-origin navigation for ~50s trying
# it before falling back to h2, which was breaking the first OAuth callback.
{
	auto_https off
	servers {
		protocols h1 h2
	}
}

:8443 {
	tls /etc/letsencrypt/live/{env.CERT_DOMAIN}/fullchain.pem /etc/letsencrypt/live/{env.CERT_DOMAIN}/privkey.pem
	reverse_proxy web:8000
}
